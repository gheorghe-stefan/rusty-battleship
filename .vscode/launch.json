{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Battleship",
            "cargo": {
                "args": [
                    "build",
                    "--bin=rusty-battleship",
                    "--package=rusty-battleship"
                ],
                "filter": {
                    "name": "rusty-battleship",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Tests",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--package=rusty-battleship"
                ],
                "filter": {
                    "name": "rusty-battleship",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
